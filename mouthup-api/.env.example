NODE_ENV=production
PORT=3000
API_PREFIX=api/v1

# Local dev (docker compose in mouthup-api/)
# DATABASE_URL=postgresql://mouthup:mouthup_dev@127.0.0.1:5432/mouthup?schema=public

# VPS production (copy to mouthup-api/.env on server)
DATABASE_URL=postgresql://mouthup:YOUR_DB_PASSWORD@postgres:5432/nestjs?schema=public

# Generate: openssl rand -base64 48  (or bash deploy/generate-secrets.sh)
JWT_ACCESS_SECRET=generate-with-openssl-rand-base64-48
JWT_REFRESH_SECRET=generate-with-openssl-rand-base64-48
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

REDIS_URL=redis://127.0.0.1:6379

# Production URLs — ISZI on ogmario64.fun
APP_URL=https://app.ogmario64.fun
ADMIN_URL=https://admin.ogmario64.fun
MEDIA_PUBLIC_URL=https://api.ogmario64.fun/uploads

# Local dev URLs (uncomment when running flutter web locally)
# APP_URL=http://localhost:57400
# ADMIN_URL=http://localhost:3001
# MEDIA_PUBLIC_URL=http://localhost:3000/uploads

# Email (Resend) — required in production unless AUTO_VERIFY_EMAIL=true
RESEND_API_KEY=
EMAIL_FROM=ISZI <noreply@ogmario64.fun>
AUTO_VERIFY_EMAIL=false

# Firebase Cloud Messaging + Google auth
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=
FCM_SERVER_KEY=

# S3-compatible storage — leave empty for local uploads/
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=iszi-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=

# Admin seed (min 12 chars — required in production)
ADMIN_EMAIL=admin@mouthup.app
ADMIN_PASSWORD=

# Bots (disable for marketplace-only production)
SEED_BOTS=false
BOT_POSTING_ENABLED=false
BOT_WORKER=false
BOT_POST_MIN_DELAY_MS=35000
BOT_POST_MAX_DELAY_MS=75000
