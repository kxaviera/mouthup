NODE_ENV=production
PORT=3000
API_PREFIX=api/v1

# PostgreSQL — match your Docker stack (database: nestjs)
DATABASE_URL=postgresql://mouthup:YOUR_DB_PASSWORD@127.0.0.1:5432/nestjs?schema=public

# Generate: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

REDIS_URL=redis://127.0.0.1:6379

# Replace mouthup.app with your domain
APP_URL=https://app.mouthup.app
ADMIN_URL=https://admin.mouthup.app
MEDIA_PUBLIC_URL=https://api.mouthup.app/uploads

# Email (Resend) — https://resend.com
RESEND_API_KEY=
EMAIL_FROM=MouthUp <noreply@mouthup.app>
AUTO_VERIFY_EMAIL=false

# Firebase — paste full service account JSON on one line
FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional S3/R2 media (leave empty for local uploads/)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=mouthup-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=

# Admin (change password before first deploy!)
ADMIN_EMAIL=admin@mouthup.app
ADMIN_PASSWORD=

# Bots
SEED_BOTS=true
BOT_POSTING_ENABLED=true
BOT_WORKER=true
BOT_POST_MIN_DELAY_MS=35000
BOT_POST_MAX_DELAY_MS=75000
