generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum MediaType {
  IMAGE
  VIDEO
}

enum MessageType {
  TEXT
  EMOJI
  GIF
  STICKER
}

enum NotificationType {
  COMMENT
  DM
  SYSTEM
  REPORT_UPDATE
}

enum ReportTargetType {
  POST
  COMMENT
  USER
}

enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

enum SupportReactionType {
  HUG
  STRENGTH
  SAME
}

enum PostMood {
  ANXIOUS
  LOW
  ANGRY
  GOOD
  CONFUSED
  EXCITED
}

enum ListingType {
  SALE
  RENT
  SWAP
  GIVEAWAY
  SERVICE
  SERVICE_REQUEST
}

enum AccountType {
  BUYER
  SELLER
  BOTH
  SERVICE_PROVIDER
}

enum Profession {
  PLUMBER
  ELECTRICIAN
  CHEF
  PAINTER
  CARPENTER
  AC_REPAIR
  CLEANER
  DRIVER
  TUTOR
  MECHANIC
  GARDENER
  BEAUTICIAN
  PHOTOGRAPHER
  OTHER
}

enum ListingStatus {
  OPEN
  CLOSED
}

enum RentPeriod {
  DAY
  WEEK
  MONTH
}

model User {
  id              String    @id @default(cuid())
  email             String    @unique
  passwordHash      String?   @map("password_hash")
  firebaseUid       String?   @unique @map("firebase_uid")
  authProvider      String?   @map("auth_provider")
  username          String?   @unique
  screenName        String?   @map("screen_name")
  usernameLocked  Boolean   @default(false) @map("username_locked")
  emailVerified   Boolean   @default(false) @map("email_verified")
  onboardingDone  Boolean   @default(false) @map("onboarding_done")
  avatarSeed      String    @default(cuid()) @map("avatar_seed")
  isVerified      Boolean   @default(false) @map("is_verified")
  role            UserRole  @default(USER)
  bannedAt        DateTime? @map("banned_at")
  banReason       String?   @map("ban_reason")
  pushEnabled     Boolean   @default(true) @map("push_enabled")
  dailyReminder   Boolean   @default(true) @map("daily_reminder")
  fcmToken        String?   @map("fcm_token")
  isBot           Boolean   @default(false) @map("is_bot")
  region          String?   @map("region")
  signupIp        String?   @map("signup_ip")
  signupCountry   String?   @map("signup_country")
  signupRegion    String?   @map("signup_region")
  signupCity      String?   @map("signup_city")
  accountType     AccountType? @map("account_type")
  profession      Profession?  @map("profession")
  city            String?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([isBot])
  @@index([accountType])
  @@index([profession])
  @@index([city])

  posts              Post[]
  comments           Comment[]
  saves              Save[]
  blocksInitiated    Block[]        @relation("BlockInitiator")
  blocksReceived     Block[]        @relation("BlockTarget")
  sentMessages       DirectMessage[] @relation("MessageSender")
  receivedMessages   DirectMessage[] @relation("MessageRecipient")
  notifications      Notification[]
  reportsFiled       Report[]       @relation("ReportReporter")
  refreshTokens      RefreshToken[]
  verificationCodes  VerificationCode[]
  postSupportReactions PostSupportReaction[]
  likes                PostLike[]
  followers            Follow[] @relation("UserFollowers")
  following            Follow[] @relation("UserFollowing")

  @@index([createdAt(sort: Desc)])
  @@index([bannedAt])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model VerificationCode {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  code      String
  purpose   String
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("verification_codes")
}

model Post {
  id            String         @id @default(cuid())
  authorId      String         @map("author_id")
  title         String?
  content       String
  hashtags      Json           @default("[]")
  mood          PostMood?      @map("mood")
  listingType   ListingType?   @map("listing_type")
  listingStatus ListingStatus  @default(OPEN) @map("listing_status")
  price         Decimal?       @db.Decimal(12, 2)
  currency      String         @default("INR")
  rentPeriod    RentPeriod?    @map("rent_period")
  swapFor       String?        @map("swap_for")
  location      String?
  viewCount     Int            @default(0) @map("view_count")
  sourceUrl     String?        @unique @map("source_url")
  deletedAt     DateTime?      @map("deleted_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  author   User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  media    PostMedia[]
  comments Comment[]
  saves    Save[]
  reports  Report[]    @relation("ReportPost")
  supportReactions PostSupportReaction[]
  likes    PostLike[]

  @@index([createdAt(sort: Desc)])
  @@index([mood])
  @@index([listingType, listingStatus, createdAt(sort: Desc)])
  @@index([authorId, createdAt(sort: Desc)])
  @@index([deletedAt])
  @@map("posts")
}

model PostMedia {
  id        String    @id @default(cuid())
  postId    String    @map("post_id")
  type      MediaType
  url       String
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, sortOrder])
  @@map("post_media")
}

model PostSupportReaction {
  userId    String               @map("user_id")
  postId    String               @map("post_id")
  type      SupportReactionType
  createdAt DateTime             @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([postId])
  @@map("post_support_reactions")
}

model PostLike {
  userId    String   @map("user_id")
  postId    String   @map("post_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([postId])
  @@map("post_likes")
}

model Follow {
  followerId  String   @map("follower_id")
  followingId String   @map("following_id")
  createdAt   DateTime @default(now()) @map("created_at")

  follower  User @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
  @@map("follows")
}

model Comment {
  id        String    @id @default(cuid())
  postId    String    @map("post_id")
  authorId  String    @map("author_id")
  content   String
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt(sort: Asc)])
  @@index([authorId])
  @@map("comments")
}

model Save {
  userId    String   @map("user_id")
  postId    String   @map("post_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("saves")
}

model Block {
  blockerId String   @map("blocker_id")
  blockedId String   @map("blocked_id")
  createdAt DateTime @default(now()) @map("created_at")

  blocker User @relation("BlockInitiator", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlockTarget", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockerId])
  @@map("blocks")
}

model DirectMessage {
  id          String      @id @default(cuid())
  senderId    String      @map("sender_id")
  recipientId String      @map("recipient_id")
  type        MessageType @default(TEXT)
  content     String
  readAt      DateTime?   @map("read_at")
  createdAt   DateTime    @default(now()) @map("created_at")

  sender    User @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([senderId, recipientId, createdAt(sort: Desc)])
  @@index([recipientId, readAt])
  @@map("direct_messages")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String           @map("user_id")
  type      NotificationType
  title     String
  body      String
  route     String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt(sort: Desc)])
  @@map("notifications")
}

model Report {
  id           String           @id @default(cuid())
  reporterId   String           @map("reporter_id")
  targetType   ReportTargetType @map("target_type")
  targetPostId String?          @map("target_post_id")
  targetUserId String?          @map("target_user_id")
  targetCommentId String?       @map("target_comment_id")
  reason       String
  status       ReportStatus     @default(PENDING)
  adminNote    String?          @map("admin_note")
  resolvedAt   DateTime?        @map("resolved_at")
  createdAt    DateTime         @default(now()) @map("created_at")

  reporter   User  @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetPost Post? @relation("ReportPost", fields: [targetPostId], references: [id], onDelete: SetNull)

  @@index([status, createdAt(sort: Desc)])
  @@index([targetType])
  @@map("reports")
}

/// Denormalized hashtag counts for fast trending — updated via background job
model HashtagStat {
  tag       String   @id
  postCount Int      @default(0) @map("post_count")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([postCount(sort: Desc)])
  @@map("hashtag_stats")
}
