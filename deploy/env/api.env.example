NODE_ENV=production
PORT=3000
API_PREFIX=api/v1

# PostgreSQL — use Docker service name inside compose network
DATABASE_URL=postgresql://mouthup:YOUR_DB_PASSWORD@postgres:5432/nestjs?schema=public

# Generate on VPS: bash deploy/generate-secrets.sh
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

REDIS_URL=redis://redis:6379

# Public URLs (CORS + media links)
APP_URL=https://app.ogmario64.fun
ADMIN_URL=https://admin.ogmario64.fun
MEDIA_PUBLIC_URL=https://api.ogmario64.fun/uploads

# Email (Resend) — https://resend.com
RESEND_API_KEY=
EMAIL_FROM=ISZI <noreply@ogmario64.fun>
AUTO_VERIFY_EMAIL=false

# Firebase (Google login + FCM push) — paste service account JSON on one line
FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional S3/R2 media (leave empty for local uploads/ volume)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=iszi-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=

# Admin seed — set before first: npm run db:seed
ADMIN_EMAIL=admin@mouthup.app
ADMIN_PASSWORD=

# Marketplace production (bots off)
SEED_BOTS=false
BOT_POSTING_ENABLED=false
BOT_WORKER=false
BOT_POST_MIN_DELAY_MS=35000
BOT_POST_MAX_DELAY_MS=75000
