NODE_ENV=production
PORT=3000
API_PREFIX=api/v1

# PostgreSQL (VPS example — database name from your Docker stack)
DATABASE_URL=postgresql://mouthup:YOUR_STRONG_PASSWORD@127.0.0.1:5432/mouthup?schema=public

JWT_ACCESS_SECRET=generate-with-openssl-rand-base64-48
JWT_REFRESH_SECRET=generate-with-openssl-rand-base64-48
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

REDIS_URL=redis://127.0.0.1:6379

# Public URLs (required for CORS + media links)
APP_URL=https://app.yourdomain.com
ADMIN_URL=https://admin.yourdomain.com
MEDIA_PUBLIC_URL=https://api.yourdomain.com/uploads

# Email (Resend) — leave empty to auto-verify new users
RESEND_API_KEY=
EMAIL_FROM=MouthUp <noreply@mouthup.app>
AUTO_VERIFY_EMAIL=false

# Firebase Cloud Messaging — prefer service account (FCM HTTP v1)
FIREBASE_SERVICE_ACCOUNT_JSON=
# Or path to service account JSON file
GOOGLE_APPLICATION_CREDENTIALS=
# Legacy fallback (deprecated — use service account instead)
FCM_SERVER_KEY=

# S3-compatible storage (Cloudflare R2, AWS S3) — leave empty for local uploads/
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=mouthup-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=

# Admin seed (set strong password before first deploy)
ADMIN_EMAIL=admin@mouthup.app
ADMIN_PASSWORD=change-me-before-deploy

# Bot news feed
SEED_BOTS=true
SEED_DEMO_USER=true
DEMO_LOGIN_ENABLED=true
BOT_POSTING_ENABLED=true
BOT_WORKER=true
BOT_POST_MIN_DELAY_MS=35000
BOT_POST_MAX_DELAY_MS=75000
